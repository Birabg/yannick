<%- include('partials/head') %>
<main id="main" class="section error-page">
  <div class="container container--narrow">
    <p class="error-page__code" aria-hidden="true">Oops</p>
    <h1 class="section__title">Something went wrong</h1>
    <p><%= message || 'We hit an unexpected problem on our side. Please try again in a moment.' %></p>
    <div class="hero__cta">
      <a class="btn btn-primary" href="/">Back to home</a>
      <a class="btn btn-wa" href="<%= fmt.genericLink() %>" target="_blank" rel="noopener"><%- icon('whatsapp') %>Order on WhatsApp</a>
    </div>
  </div>
</main>
<%- include('partials/foot') %>
