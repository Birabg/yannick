<%
  const base = path === '/' ? '' : '/';
%>
<button class="totop" type="button" data-totop aria-label="Back to top"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>
<footer class="foot" data-footer>
  <div class="foot__photo" aria-hidden="true">
    <% if (footerPhoto) {
      const L = footerPhoto.landscape, P = footerPhoto.portrait;
      const set = function (prefix, widths, ext) { return widths.map(function (w) { return '/img/footer/' + prefix + '-' + w + '.' + ext + ' ' + w + 'w'; }).join(', '); };
      const top = L.widths[L.widths.length - 1];
    %>
    <picture>
      <source media="(max-width: 699px)" type="image/avif" srcset="<%= set('footer-portrait', P.widths, 'avif') %>" sizes="100vw">
      <source media="(max-width: 699px)" type="image/webp" srcset="<%= set('footer-portrait', P.widths, 'webp') %>" sizes="100vw">
      <source type="image/avif" srcset="<%= set('footer', L.widths, 'avif') %>" sizes="100vw">
      <source type="image/webp" srcset="<%= set('footer', L.widths, 'webp') %>" sizes="100vw">
      <img class="foot__img" src="/img/footer/footer-<%= top %>.webp" width="<%= L.ratio[0] %>" height="<%= L.ratio[1] %>" alt="" loading="lazy" decoding="async" data-footer-img>
    </picture>
    <% } %>
    <span class="foot__shade"></span>
    <span class="foot__grain"></span>
  </div>

  <div class="container foot__main">
    <p class="foot__brand"><img class="foot__mark" src="/favicon.svg" width="28" height="28" alt="" decoding="async"><span>Yannick Scents</span></p>

    <div class="foot__cols">
      <nav class="foot__col" aria-labelledby="foot-nav">
        <h2 class="foot__title" id="foot-nav" <%- i('footer.nav') %>><%= t('footer.nav') %></h2>
        <ul>
          <li><a class="foot__link" href="<%= base %>#story" <%- i('nav.story') %>><%= t('nav.story') %></a></li>
          <li><a class="foot__link" href="<%= base %>#collection" <%- i('nav.collection') %>><%= t('nav.collection') %></a></li>
          <li><a class="foot__link" href="<%= base %>#find" <%- i('nav.find') %>><%= t('nav.find') %></a></li>
          <li><a class="foot__link" href="<%= base %>#faq" <%- i('nav.faq') %>><%= t('nav.faq') %></a></li>
        </ul>
      </nav>
      <nav class="foot__col" aria-labelledby="foot-order">
        <h2 class="foot__title" id="foot-order" <%- i('footer.order') %>><%= t('footer.order') %></h2>
        <ul>
          <li><a class="foot__link" href="tel:<%= site.contact.phone %>" <%- i('cta.call') %>><%= t('cta.call') %></a></li>
          <li><a class="foot__link" href="<%= fmt.genericLink() %>" target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a class="foot__link" href="<%= site.contact.tiktok %>" target="_blank" rel="noopener">TikTok</a></li>
          <li><a class="foot__link" href="<%= base %>#delivery" <%- i('footer.delivery') %>><%= t('footer.delivery') %></a></li>
        </ul>
      </nav>
      <nav class="foot__col" aria-labelledby="foot-visit">
        <h2 class="foot__title" id="foot-visit" <%- i('footer.visit') %>><%= t('footer.visit') %></h2>
        <ul>
          <li><a class="foot__link" href="<%= base %>#order"><%= site.location.city %></a></li>
          <li><a class="foot__link" href="<%= base %>#hours" <%- i('footer.hours') %>><%= t('footer.hours') %></a></li>
          <li><a class="foot__link" href="<%= base %>#delivery" <%- i('footer.freedelivery') %>><%= t('footer.freedelivery') %></a></li>
        </ul>
      </nav>
    </div>
  </div>

  <div class="container foot__legal">
    <p>&copy; <%= year %> <%= site.brand.name %>. <span <%- i('footer.rights') %>><%= t('footer.rights') %></span></p>
    <p><span <%- i('footer.built') %>><%= t('footer.built') %></span> <a class="foot__link foot__link--inline" href="<%= site.contact.credit.url %>"><%= site.contact.credit.label %></a></p>
  </div>

  <svg class="foot__word" viewBox="0 0 1000 175" role="img" aria-label="<%= site.brand.name %>" data-footer-word>
    <text x="500" y="235" text-anchor="middle" textLength="1000" lengthAdjust="spacingAndGlyphs">Yannick</text>
  </svg>
</footer>

<div class="mobile-bar" role="group" aria-label="Quick contact">
  <a class="mobile-bar__link" href="tel:<%= site.contact.phone %>"><%- icon('phone') %><span <%- i('cta.call') %>><%= t('cta.call') %></span></a>
  <a class="mobile-bar__link mobile-bar__link--wa" href="<%= fmt.genericLink() %>" target="_blank" rel="noopener"><%- icon('whatsapp') %><span>WhatsApp</span></a>
</div>

<script type="module" src="<%= asset('main.js') %>"></script>
</body>
</html>
