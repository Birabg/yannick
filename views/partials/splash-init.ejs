<%# Splash flag. Every public page marks the session as started; only the home page (splash: true) may show the splash, and only on the first page of a session. %>
<script nonce="<%= cspNonce %>">
(function () {
  var h = document.documentElement, seen;
  try { seen = sessionStorage.getItem('ys-sp'); sessionStorage.setItem('ys-sp', '1'); } catch (e) { seen = 1; }
<% if (locals.splash) { %>
  if (seen || matchMedia('(prefers-reduced-motion:reduce)').matches) return;
  var m = document.querySelector('meta[name=theme-color]');
  h.classList.add('sp');
  m.setAttribute('content', '#14110f');
  // Also the hard timeout: whatever happens, the overlay is gone, scroll is back and the theme colour restored by 2.2s.
  window.__spf = function () {
    var e = document.querySelector('.spl');
    if (e) e.remove();
    h.classList.remove('sp', 'sp-on');
    h.classList.add('sp-go');
    m.setAttribute('content', h.getAttribute('data-theme') === 'dark' ? '#100e0c' : '#fbfaf7');
  };
  setTimeout(window.__spf, 2200);
<% } %>
})();
</script>
<% if (locals.splash) { %>
<style nonce="<%= cspNonce %>">
html.sp{overflow:hidden;scrollbar-gutter:stable;background:#14110f}
html.sp::before{content:"";position:fixed;inset:0;z-index:9998;background:#14110f}
html.sp-on::before{display:none}
.spl{--e:cubic-bezier(.22,.8,.2,1);position:fixed;inset:0;z-index:9999;display:grid;place-items:center;background:#14110f;color:#f7f3ec;font:600 12px/1 Urbanist,system-ui,sans-serif}
.spl.out{animation:sp-out 450ms var(--e) forwards}
.spl.quick{animation:sp-quick 160ms linear forwards}
.sp-art{width:min(80vw,480px);height:auto;overflow:visible}
.sp-art path,.sp-art circle,.sp-art g{transform-box:fill-box;transform-origin:50% 50%}
.sa1,.sa2{fill:none;stroke:#f7f3ec;stroke-width:9.2;stroke-dasharray:1;stroke-dashoffset:1;animation:sp-draw 550ms var(--e) 100ms forwards}
.sa2{animation-duration:320ms;animation-delay:450ms}
.sy,.sy path,.st1,.st2,.st1 path,.st2 path{fill:#f7f3ec}
.sy{opacity:0;animation:sp-up 600ms var(--e) 250ms forwards}
.sp-art .sdr{fill:#ffa100;transform-origin:50% 100%;opacity:0;animation:sp-pop 450ms var(--e) 650ms forwards}
.sgl{fill:url(#sp-g);opacity:0;animation:sp-glow 800ms var(--e) 700ms}
.sm{fill:#ffa100;opacity:0;animation:sp-mist 850ms var(--e) 750ms}
.sm2{animation-delay:790ms}.sm3{animation-delay:830ms}.sm4{animation-delay:870ms}.sm5{animation-delay:810ms}.sm6{animation-delay:850ms}.sm7{animation-delay:890ms}.sm8{animation-delay:930ms}
.sm1{--x:-60px;--y:-50px}.sm2{--x:60px;--y:-56px}.sm3{--x:-84px;--y:4px}.sm4{--x:86px;--y:10px}.sm5{--x:-28px;--y:-82px}.sm6{--x:32px;--y:-88px}.sm7{--x:-52px;--y:42px}.sm8{--x:56px;--y:46px}
.st1,.st2{opacity:0;animation:sp-text 520ms var(--e) 800ms forwards}
.st2{animation-duration:460ms;animation-delay:960ms}
.sl{fill:none;stroke:#ffa100;stroke-width:2.4;transform:scaleX(0);animation:sp-line 480ms var(--e) 1000ms forwards}
.sp-art .sl1{transform-origin:100% 50%}.sp-art .sl2{transform-origin:0 50%}
.sp-skip{position:absolute;top:max(16px,env(safe-area-inset-top));right:16px;min-width:44px;min-height:44px;padding:0 16px;border:1px solid rgba(247,243,236,.3);border-radius:999px;background:none;color:rgba(247,243,236,.8);font:inherit;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;opacity:0;animation:sp-fade 300ms linear 300ms forwards}
@keyframes sp-draw{to{stroke-dashoffset:0}}
@keyframes sp-up{from{transform:translateY(26px)}to{opacity:1;transform:none}}
@keyframes sp-pop{from{transform:scale(.2)}to{opacity:1;transform:none}}
@keyframes sp-glow{40%{opacity:1}to{opacity:0;transform:scale(1.5)}}
@keyframes sp-mist{15%{opacity:.9}to{opacity:0;transform:translate(var(--x),var(--y))}}
@keyframes sp-text{from{transform:translateY(14px) scaleX(1.1)}to{opacity:1;transform:none}}
@keyframes sp-line{to{transform:none}}
@keyframes sp-fade{to{opacity:1}}
@keyframes sp-out{to{transform:translateY(-100%)}}
@keyframes sp-quick{to{opacity:0}}
html.sp-go .w{animation-name:sp-w}
html.sp-go .hc{animation-name:sp-r}
@keyframes sp-w{to{transform:none}}
@keyframes sp-r{from{opacity:0;transform:translateY(36px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.spl{display:none}}
</style>
<% } %>
