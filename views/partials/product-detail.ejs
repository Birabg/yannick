<%
  const label = fmt.productLabel(p);
  const src = p.image ? imageUrl(p, 'lg') : '/img/bottle-placeholder.svg';
  const Heading = modal ? 'h2' : 'h1';
  const stages = [['Top notes', p.notes.top], ['Heart notes', p.notes.heart], ['Base notes', p.notes.base]];
  const meters = [['Longevity', p.longevity], ['Projection', p.projection]];
%>
<div class="detail">
  <div class="detail__media">
    <img src="<%= src %>" width="1000" height="1250" alt="<%= label %> bottle" <%- modal ? '' : 'fetchpriority="high"' %>>
  </div>
  <div class="detail__info">
    <p class="detail__brand"><%= p.brand %></p>
    <<%= Heading %> class="detail__name" <%- modal ? 'id="modal-title"' : '' %>><%= p.name %></<%= Heading %>>
    <p class="detail__meta"><%= [p.size, p.concentration, p.family].filter(Boolean).join(' · ') %></p>
    <p class="detail__price"><%= fmt.price(p.price) %></p>

    <p class="detail__flags">
      <% if (!p.inStock) { %><span class="flag flag--soldout">Sold out</span><% } %>
      <% if (p.isSample) { %><span class="flag flag--sample">Sample</span><% } %>
      <% site.badges.filter(function (b) { return p.badges.includes(b.key); }).forEach(function (b) { %>
      <span class="flag"><%= b.label %></span>
      <% }) %>
    </p>

    <% if (p.description) { %><p class="detail__text"><%= p.description %></p><% } %>

    <dl class="detail__notes">
      <% stages.forEach(function (stage) { if (!stage[1].length) return; %>
      <div>
        <dt><%= stage[0] %></dt>
        <dd>
          <ul class="tags">
            <% stage[1].forEach(function (note) { %><li><%= note %></li><% }) %>
          </ul>
        </dd>
      </div>
      <% }) %>
    </dl>

    <div class="meters">
      <% meters.forEach(function (m) { %>
      <div class="meter">
        <span class="meter__label"><%= m[0] %></span>
        <span class="meter__dots" role="img" aria-label="<%= m[0] %>: <%= m[1] %> out of 5">
          <% for (let n = 1; n <= 5; n++) { %><span class="meter__dot<%= n <= m[1] ? ' is-on' : '' %>"></span><% } %>
        </span>
      </div>
      <% }) %>
    </div>

    <div class="detail__actions">
      <a class="btn <%= p.inStock ? 'btn-wa' : 'btn-outline' %>" href="<%= fmt.orderLink(p) %>" target="_blank" rel="noopener">
        <%- icon('whatsapp') %><%= p.inStock ? 'Order on WhatsApp' : 'Ask when back in stock' %>
      </a>
      <a class="btn btn-outline" href="tel:<%= site.contact.phone %>"><%- icon('phone') %>Call <%= site.contact.phoneDisplay %></a>
    </div>
    <p class="detail__note"><%- icon('truck') %> Free delivery across Addis Ababa</p>
  </div>
</div>
