<%
  const base = path === '/' ? '' : '/';
  const left = [['story', 'nav.story'], ['collection', 'nav.collection'], ['notes', 'nav.notes'], ['houses', 'nav.houses']];
  const right = [['find', 'nav.find'], ...(locals.hasReviews ? [['reviews', 'nav.reviews']] : []), ['faq', 'nav.faq']];
%>
<header class="site-header">
  <div class="container site-header__inner">
    <button class="icon-btn nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <%- icon('menu') %><%- icon('close') %>
    </button>

    <a class="logo" href="/">Yannick <em>Scents</em></a>

    <nav class="nav" id="site-nav" aria-label="Main">
      <ul class="nav__list nav__list--left">
        <% left.forEach(function (item) { %>
        <li><a class="nav__link" href="<%= base %>#<%= item[0] %>" <%- i(item[1]) %>><%= t(item[1]) %></a></li>
        <% }) %>
      </ul>
      <ul class="nav__list nav__list--right">
        <% right.forEach(function (item) { %>
        <li><a class="nav__link" href="<%= base %>#<%= item[0] %>" <%- i(item[1]) %>><%= t(item[1]) %></a></li>
        <% }) %>
        <li class="nav__mobile-only"><a class="nav__link" href="<%= base %>#order" <%- i('nav.order') %>><%= t('nav.order') %></a></li>
        <li><a class="nav__link nav__link--cta" href="<%= fmt.genericLink() %>" target="_blank" rel="noopener" <%- i('cta.whatsapp') %>><%= t('cta.whatsapp') %></a></li>
        <li class="nav__lang"><button class="lang-toggle" type="button" data-lang-toggle aria-label="አማ - switch language to Amharic" lang="am">አማ</button></li>
      </ul>
      <div class="nav__extra">
        <%- include('../components/button', { href: fmt.genericLink(), external: true, ico: 'whatsapp', label: t('cta.whatsapp'), i18n: 'cta.whatsapp', size: 'lg', block: true }) %>
        <%- include('../components/button', { href: 'tel:' + site.contact.phone, ico: 'phone', label: site.contact.phoneDisplay, variant: 'outline', size: 'lg', block: true }) %>
        <button class="lang-toggle lang-toggle--menu" type="button" data-lang-toggle aria-label="አማ - switch language to Amharic" lang="am">አማ</button>
      </div>
    </nav>

    <a class="icon-btn header-wa" href="<%= fmt.genericLink() %>" target="_blank" rel="noopener" aria-label="Order on WhatsApp"><%- icon('whatsapp') %></a>
  </div>
</header>
