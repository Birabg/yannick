<%
  const title = seo.title || site.brand.name;
  const description = seo.description || site.brand.description;
  const canonical = seo.canonical ? siteUrl + seo.canonical : '';
  const ogImage = seo.image ? siteUrl + seo.image : siteUrl + siteImage('share');
%><!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <% if (seo.noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
  <% if (canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
  <%- include('theme-init') %>
  <%- include('splash-init') %>

  <meta property="og:site_name" content="<%= site.brand.name %>">
  <meta property="og:type" content="<%= seo.type === 'product' ? 'product' : 'website' %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <% if (canonical) { %><meta property="og:url" content="<%= canonical %>"><% } %>
  <meta property="og:image" content="<%= ogImage %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:description" content="<%= description %>">
  <meta name="twitter:image" content="<%= ogImage %>">

  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <link rel="preload" href="/fonts/urbanist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <% if (locals.preloadImage && preloadImage.image) { %><link rel="preload" as="image" href="<%= photo.photoUrl(preloadImage, 'sm') %>"<% if (photo.widthsOf(preloadImage).length > 1) { %> imagesrcset="<%= photo.srcset(preloadImage) %>" imagesizes="(min-width: 1024px) 260px, (min-width: 640px) 32vw, 70vw"<% } %> fetchpriority="high"><% } %>
  <link rel="preload" href="/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>

  <% const bgList = locals.products ? products : (locals.p ? [p] : []); %>
  <% if (bgList.length) { %><style nonce="<%= cspNonce %>"><%- photo.bgCss(bgList) %></style><% } %>
  <% if (criticalCss) { %>
  <style nonce="<%= cspNonce %>"><%- criticalCss %></style>
  <link rel="stylesheet" href="<%= asset(seo.stylesheet || 'main.css') %>" media="print" data-async-css>
  <noscript><link rel="stylesheet" href="<%= asset(seo.stylesheet || 'main.css') %>"></noscript>
  <% } else { %>
  <link rel="stylesheet" href="<%= asset(seo.stylesheet || 'main.css') %>">
  <% } %>
  <script nonce="<%= cspNonce %>">document.documentElement.classList.add('js');(function(){var l=document.querySelector('link[data-async-css]');if(!l)return;var s=function(){l.media='all'};if(l.sheet)s();else l.addEventListener('load',s)})()</script>
  <% (seo.jsonLd || []).forEach(function (data) { %>
  <script type="application/ld+json"><%- JSON.stringify(data).replace(/</g, '\\u003c') %></script>
  <% }) %>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <%- include('../components/icons') %>
  <%- include('header') %>
