<%
  /* params: filter (key), label, count, pressed, i18n */
%><button type="button" class="tab" data-filter="<%= filter %>" aria-pressed="<%= locals.pressed ? 'true' : 'false' %>" tabindex="<%= locals.pressed ? '0' : '-1' %>"><span<%- locals.i18n ? ' ' + i(locals.i18n) : '' %>><%= label %></span><% if (locals.count !== undefined) { %><span class="tab__n"> (<%= count %>)</span><% } %></button>
