<%
  /* params: p (product), sheet (true inside the panel, false on the full page) */
  const label = fmt.productLabel(p);
  const H = sheet ? 'h2' : 'h1';
  const acts = [['Top', p.notes.top], ['Heart', p.notes.heart], ['Base', p.notes.base]].filter(function (a) { return a[1].length; });
  const meters = [['Longevity', p.longevity], ['Projection', p.projection]].filter(function (m) { return m[1] > 0; });
%>
<article class="detail <%= photo.bgClass(p) %><%= sheet ? '' : ' detail--page' %>" data-bg-top="<%= photo.bgTop(p) %>" data-fg-top="<%= photo.bgFgTop(p) %>">
  <div class="detail__photo">
    <div class="photo<%= photo.isAlpha(p) ? ' is-alpha' : '' %>">
      <%- include('photo', { p: p, variant: 'lg', eager: !sheet, sizes: '(min-width: 900px) 600px, 100vw' }) %>
      <div class="photo__flags">
        <% if (!p.inStock) { %><%- include('badge', { kind: 'soldout', label: 'Sold out' }) %><% } %>
        <% if (p.isSample) { %><%- include('badge', { kind: 'sample', label: 'Sample' }) %><% } %>
        <% site.badges.filter(function (b) { return p.badges.includes(b.key) && b.key !== 'featured'; }).forEach(function (b) { %><%- include('badge', { kind: b.key, label: b.label }) %><% }) %>
      </div>
    </div>
  </div>
  <div class="detail__body">
    <p class="detail__brand"><%= p.brand %></p>
    <<%= H %> class="detail__name"<%- sheet ? ' id="sheet-title"' : '' %>><%= p.name %></<%= H %>>
    <p class="detail__meta"><%= [p.size, p.concentration, p.family].filter(Boolean).join(' · ') %></p>
    <% const sizes = pricing.sizeOptions(p); const first = sizes.find(function (s) { return s.inStock; }) || sizes[0]; %>
    <div class="detail__price" data-size-root>
      <% if (sizes.length) { %>
      <% sizes.forEach(function (s) { %><span data-size-price-for="<%= s.id %>"<%- s === first ? '' : ' hidden' %>><%- include('price', { p: p, size: s, cls: 'price--lg' }) %></span><% }) %>
      <% } else { %>
      <%- include('price', { p: p, cls: 'price--lg' }) %>
      <% } %>
    </div>
    <% if (sizes.length) { %>
    <div class="sizes" role="radiogroup" aria-label="Size">
      <% sizes.forEach(function (s) { %>
      <button type="button" class="size-chip<%= s.inStock ? '' : ' is-out' %>" role="radio" aria-checked="<%= s === first %>" data-size-chip="<%= s.id %>" data-href="<%= fmt.orderLink(p, s) %>" data-stock="<%= s.inStock && p.inStock ? 1 : 0 %>"><%= s.label %><%= s.inStock ? '' : ' (sold out)' %></button>
      <% }) %>
    </div>
    <% } %>

    <% if (p.tagline) { %><p class="detail__tagline"<% if (p.taglineAm) { %> data-am="<%= p.taglineAm %>"<% } %>><%= p.tagline %></p><% } %>
    <% if (p.description) { %><p class="detail__text"<% if (p.descriptionAm) { %> data-am="<%= p.descriptionAm %>"<% } %>><%= p.description %></p><% } %>

    <% if (acts.length) { %>
    <div class="pyramid" role="list" aria-label="Fragrance notes">
      <% acts.forEach(function (a) { %>
      <div class="pyramid__row" role="listitem">
        <span class="pyramid__label"><%= a[0] %></span>
        <p class="pyramid__notes"><%= a[1].join(', ') %></p>
      </div>
      <% }) %>
    </div>
    <% } %>

    <% if (meters.length) { %>
    <div class="meters">
      <% meters.forEach(function (m) { %>
      <div class="meter">
        <span class="meter__label"><%= m[0] %></span>
        <span class="meter__bars" role="img" aria-label="<%= m[0] %>: <%= m[1] %> out of 5">
          <% for (let n = 1; n <= 5; n++) { %><span class="meter__bar<%= n <= m[1] ? ' is-on' : '' %>"></span><% } %>
        </span>
      </div>
      <% }) %>
    </div>
    <% } %>

    <div class="detail__actions">
      <%- include('button', {
        href: fmt.orderLink(p, sizes.length ? first : null), external: true, ico: 'whatsapp', variant: p.inStock ? 'primary' : 'outline',
        label: p.inStock ? 'Order on WhatsApp' : 'Ask when back in stock', attrs: 'data-order-link'
      }) %>
      <%- include('button', { href: 'tel:' + site.contact.phone, ico: 'phone', variant: 'outline', label: 'Call ' + site.contact.phoneDisplay }) %>
    </div>
    <p class="detail__note">Free delivery anywhere in Addis Ababa.</p>
  </div>
</article>
