<dialog class="sheet" id="sheet" aria-label="Perfume details">
  <div class="sheet__bar">
    <span class="sheet__grab" aria-hidden="true"></span>
    <span class="sheet__title">Perfume details</span>
    <button type="button" class="icon-btn" data-sheet-close aria-label="Close details"><%- icon('close') %></button>
  </div>
  <div class="sheet__scroll">
    <div id="sheet-body"></div>
  </div>
</dialog>
