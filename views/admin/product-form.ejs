<%
  const action = isNew ? '/admin/products' : '/admin/products/' + p.id;
  const shelves = site.collections.filter(function (c) { return c.key !== 'men' && c.key !== 'women'; });
  const fe = locals.fields || {};
  const fld = function (name) { return fe[name] ? ' has-error' : ''; };
  const err = function (name) { return '<span class="field__error"' + (fe[name] ? '' : ' hidden') + '>' + (fe[name] ? fe[name].replace(/</g, '&lt;') : '') + '</span>'; };
  const fam = fmt.famKey(p);
%>
<%- include('_head', { seo: { title: isNew ? 'Add perfume' : 'Edit perfume' } }) %>
<div class="page-head">
  <h1><%= isNew ? 'Add perfume' : 'Edit ' + p.name %></h1>
  <%- include('../components/button', { href: '/admin', label: 'Cancel', variant: 'paper' }) %>
</div>

<% if (errors.length) { %>
<div class="alert alert--error" role="alert">
  <strong>Please fix the following:</strong>
  <ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul>
</div>
<% } %>

<div class="editor">
<form class="form form--wide" method="post" action="<%= action %>?_csrf=<%= csrfToken %>" enctype="multipart/form-data" novalidate data-validate data-preview-form>
  <fieldset class="box">
    <legend>Basics</legend>
    <div class="grid-2">
      <label class="field<%= fld('name') %>"><span class="field__label">Name *</span><input name="name" value="<%= p.name %>" maxlength="80" required placeholder="Bleu de Chanel"><%- err('name') %></label>
      <label class="field<%= fld('brand') %>"><span class="field__label">Brand *</span><input name="brand" value="<%= p.brand %>" maxlength="60" required list="brands" placeholder="Chanel"><%- err('brand') %></label>
      <datalist id="brands"><% site.houses.forEach(function (h) { %><option value="<%= h %>"><% }) %></datalist>
      <label class="field<%= fld('price') %>"><span class="field__label">Price (ETB) *</span><input name="price" value="<%= p.price || '' %>" inputmode="numeric" required data-numeric placeholder="15000"><%- err('price') %></label>
      <label class="field<%= fld('size') %>"><span class="field__label">Size *</span><input name="size" value="<%= p.size %>" maxlength="20" required placeholder="100ml"><%- err('size') %></label>
      <label class="field"><span class="field__label">Concentration</span>
        <select name="concentration">
          <option value="">-</option>
          <% site.concentrations.forEach(function (c) { %><option <%= p.concentration === c ? 'selected' : '' %>><%= c %></option><% }) %>
        </select>
      </label>
      <label class="field<%= fld('category') %>"><span class="field__label">Category *</span>
        <select name="category" required>
          <% site.categories.forEach(function (c) { %><option value="<%= c.key %>" <%= p.category === c.key ? 'selected' : '' %>><%= c.label %></option><% }) %>
        </select><%- err('category') %>
      </label>
      <label class="field"><span class="field__label">Scent family label</span><input name="family" value="<%= p.family %>" maxlength="60" placeholder="Woody Aromatic"></label>
    </div>

    <fieldset class="checks">
      <legend>Collection sections</legend>
      <p class="hint">Men and Women are set from the category above. The colour of the card follows the scent family you tick here.</p>
      <% shelves.forEach(function (c) { %>
      <label class="check"><input type="checkbox" name="collections" value="<%= c.key %>" <%= p.collections.includes(c.key) ? 'checked' : '' %>><span><%= c.label %></span></label>
      <% }) %>
    </fieldset>

    <fieldset class="checks">
      <legend>Badges</legend>
      <% site.badges.forEach(function (b) { %>
      <label class="check"><input type="checkbox" name="badges" value="<%= b.key %>" <%= p.badges.includes(b.key) ? 'checked' : '' %>><span><%= b.label %></span></label>
      <% }) %>
    </fieldset>

    <div class="grid-2">
      <label class="field"><span class="field__label">Availability</span>
        <select name="in_stock">
          <option value="1" <%= p.inStock ? 'selected' : '' %>>In stock</option>
          <option value="0" <%= p.inStock ? '' : 'selected' %>>Sold out</option>
        </select>
      </label>
      <label class="check check--box"><input type="checkbox" name="is_sample" <%= p.isSample ? 'checked' : '' %>><span><strong>Sample item.</strong> Shows a &ldquo;Sample&rdquo; tag. Untick once this is a real product.</span></label>
    </div>
  </fieldset>

  <fieldset class="box">
    <legend>Description and notes</legend>
    <label class="field"><span class="field__label">Description</span><textarea name="description" rows="4" maxlength="1200"><%= p.description %></textarea></label>
    <p class="hint">Notes: separate with commas, for example <em>Bergamot, Pink Pepper, Grapefruit</em>.</p>
    <div class="grid-3">
      <% [['top_notes', 'Top notes', p.notes.top], ['heart_notes', 'Heart notes', p.notes.heart], ['base_notes', 'Base notes', p.notes.base]].forEach(function (n) { %>
      <label class="field"><span class="field__label"><%= n[1] %></span><input name="<%= n[0] %>" value="<%= n[2].join(', ') %>"></label>
      <% }) %>
    </div>
    <div class="grid-2">
      <label class="field"><span class="field__label">Longevity: <output data-out="longevity"><%= p.longevity %></output> / 5</span><input type="range" name="longevity" min="1" max="5" value="<%= p.longevity %>" data-range="longevity"></label>
      <label class="field"><span class="field__label">Projection: <output data-out="projection"><%= p.projection %></output> / 5</span><input type="range" name="projection" min="1" max="5" value="<%= p.projection %>" data-range="projection"></label>
    </div>
  </fieldset>

  <fieldset class="box">
    <legend>Photo</legend>
    <%- include('_dropzone', { name: 'photo', src: p.image ? imageUrl(p, 'sm') : '', alt: 'Photo preview' }) %>
    <p class="hint">Tip: shoot the bottle on a plain white background. The website tints it with the scent family colour.</p>
  </fieldset>

  <div class="form__actions">
    <button class="btn btn--primary btn--lg" type="submit"><span>Save perfume</span><span class="btn__spinner" aria-hidden="true"></span></button>
    <%- include('../components/button', { href: '/admin', label: 'Cancel', variant: 'paper', size: 'lg' }) %>
  </div>
</form>

<aside class="preview" aria-label="Live preview">
  <p class="label">Live preview</p>
  <article class="card fam--<%= fam %>" data-preview-card>
    <div class="card__media">
      <div class="photo">
        <img class="photo__img" src="<%= p.image ? imageUrl(p, 'sm') : '/img/bottle-placeholder.svg' %>" width="480" height="600" alt="" data-preview-img>
        <div class="photo__flags" data-preview-flags></div>
      </div>
    </div>
    <div class="card__body">
      <p class="card__brand" data-preview-brand><%= p.brand || 'Brand' %></p>
      <h3 class="card__name" data-preview-name><%= p.name || 'Perfume name' %></h3>
      <p class="card__line">
        <span data-preview-meta><%= [p.size, p.concentration].filter(Boolean).join(' · ') || '100ml' %></span>
        <span class="card__price"><%= site.currency %> <span data-preview-price><%= p.price ? p.price.toLocaleString('en-US') : '0' %></span></span>
      </p>
    </div>
  </article>
</aside>
</div>
<%- include('_foot') %>
