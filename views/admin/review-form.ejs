<%
  const fe = locals.fields || {};
%>
<%- include('_head', { seo: { title: isNew ? 'Add review' : 'Edit review' } }) %>
<div class="page-head">
  <h1><%= isNew ? 'Add review' : 'Edit review' %></h1>
  <%- include('../components/button', { href: '/admin/reviews', label: 'Cancel', variant: 'paper' }) %>
</div>

<% if (errors.length) { %>
<div class="alert alert--error" role="alert"><strong>Please fix the following:</strong><ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div>
<% } %>

<form class="form form--narrow" method="post" action="<%= isNew ? '/admin/reviews' : '/admin/reviews/' + r.id %>?_csrf=<%= csrfToken %>" enctype="multipart/form-data" novalidate data-validate>
  <fieldset class="box">
    <legend>Review</legend>
    <label class="field<%= fe.name ? ' has-error' : '' %>"><span class="field__label">Customer name *</span><input name="name" value="<%= r.name %>" maxlength="60" required><span class="field__error" <%- fe.name ? '' : 'hidden' %>><%= fe.name || '' %></span></label>
    <label class="field<%= fe.text ? ' has-error' : '' %>"><span class="field__label">What they said *</span><textarea name="text" rows="4" maxlength="600" required><%= r.text %></textarea><span class="field__error" <%- fe.text ? '' : 'hidden' %>><%= fe.text || '' %></span></label>
    <label class="field"><span class="field__label">Rating *</span>
      <select name="rating">
        <% [5, 4, 3, 2, 1].forEach(function (n) { %><option value="<%= n %>" <%= Number(r.rating) === n ? 'selected' : '' %>><%= n %> / 5</option><% }) %>
      </select>
    </label>
    <div class="field">
      <span class="field__label">Screenshot (optional)</span>
      <%- include('_dropzone', { name: 'screenshot', src: r.image ? '/uploads/reviews/' + r.image : '', alt: 'Screenshot preview' }) %>
    </div>
    <% if (r.image) { %><label class="check"><input type="checkbox" name="remove_image"><span>Remove current screenshot</span></label><% } %>
  </fieldset>
  <div class="form__actions">
    <button class="btn btn--primary btn--lg" type="submit"><span>Save review</span><span class="btn__spinner" aria-hidden="true"></span></button>
    <%- include('../components/button', { href: '/admin/reviews', label: 'Cancel', variant: 'paper', size: 'lg' }) %>
  </div>
</form>
<%- include('_foot') %>
