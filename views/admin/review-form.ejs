<%- include('_head', { seo: { title: isNew ? 'Add review' : 'Edit review' } }) %>
<div class="page-head">
  <h1><%= isNew ? 'Add review' : 'Edit review' %></h1>
  <a class="btn btn-outline" href="/admin/reviews">Cancel</a>
</div>

<% if (errors.length) { %>
<div class="alert alert--error" role="alert">
  <strong>Please fix the following:</strong>
  <ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul>
</div>
<% } %>

<form class="form form--wide" method="post" action="<%= isNew ? '/admin/reviews' : '/admin/reviews/' + r.id %>?_csrf=<%= csrfToken %>" enctype="multipart/form-data" novalidate>
  <fieldset class="card-box">
    <legend>Review</legend>
    <label class="field"><span>Customer name *</span><input name="name" value="<%= r.name %>" maxlength="60" required></label>
    <label class="field"><span>What they said *</span><textarea name="text" rows="4" maxlength="600" required><%= r.text %></textarea></label>
    <label class="field"><span>Rating *</span>
      <select name="rating">
        <% [5, 4, 3, 2, 1].forEach(function (n) { %><option value="<%= n %>" <%= Number(r.rating) === n ? 'selected' : '' %>><%= n %> / 5</option><% }) %>
      </select>
    </label>
    <label class="field"><span>Screenshot (optional, JPG, PNG or WebP, max 5 MB)</span><input type="file" name="screenshot" accept="image/jpeg,image/png,image/webp"></label>
    <% if (r.image) { %>
    <div class="photo">
      <img src="/uploads/reviews/<%= r.image %>" width="120" alt="Current screenshot">
      <label class="check"><input type="checkbox" name="remove_image"><span>Remove current screenshot</span></label>
    </div>
    <% } %>
  </fieldset>
  <div class="form__actions">
    <button class="btn btn-primary btn-lg" type="submit">Save review</button>
    <a class="btn btn-outline btn-lg" href="/admin/reviews">Cancel</a>
  </div>
</form>
<%- include('_foot') %>
