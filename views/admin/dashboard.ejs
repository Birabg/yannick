<%- include('_head', { seo: { title: 'Perfumes' } }) %>
<div class="page-head">
  <h1>Perfumes <span class="count"><%= products.length %></span></h1>
  <%- include('../components/button', { href: '/admin/products/new', ico: 'plus', label: 'Add perfume', variant: 'primary' }) %>
</div>

<% if (hasSamples) { %>
<p class="alert alert--warn" role="note">
  <strong>Sample items.</strong> Perfumes tagged <span class="sticker sticker--sample">Sample</span> are placeholders with made-up prices and drawn bottles.
  Edit each one with your real details and photo, or delete it, before the site goes live.
</p>
<% } %>

<% const needing = products.filter(function (p) { return p.needsDetails; }).length; %>
<% if (needing) { %>
<p class="alert alert--warn" role="note">
  <strong><%= needing %> perfume<%= needing === 1 ? '' : 's' %> need details.</strong>
  Those tagged <span class="sticker sticker--needs">Needs details</span> have no price, size or concentration yet, so the site shows &ldquo;Ask for price&rdquo;.
  Open each one with Edit to complete it.
</p>
<% } %>

<% const drafts = products.filter(function (p) { return p.descriptionDraft; }).length; %>
<% if (drafts) { %>
<p class="alert alert--warn" role="note">
  <strong><%= drafts %> description<%= drafts === 1 ? ' is a' : 's are' %> draft<%= drafts === 1 ? '' : 's' %>.</strong>
  Those tagged <span class="sticker sticker--draft">Draft text</span> are live on the site but written for you to check. Open Edit, correct anything wrong (the Amharic needs a native speaker), then tick <em>Approved</em>.
</p>
<% } %>

<% if (products.length === 0) { %>
<div class="empty">
  <p class="empty__title">No perfumes yet.</p>
  <p>Add your first bottle and it shows up on the website straight away.</p>
  <%- include('../components/button', { href: '/admin/products/new', ico: 'plus', label: 'Add your first perfume', variant: 'primary' }) %>
</div>
<% } else { %>
<div class="searchbar search">
  <label class="sr-only" for="admin-search">Search perfumes</label>
  <%- icon('search') %>
  <input id="admin-search" type="search" placeholder="Search by name or brand" autocomplete="off" data-admin-search>
</div>

<ul class="plist" id="plist">
  <% products.forEach(function (p, idx) { %>
  <li class="prow<%= p.inStock ? '' : ' is-soldout' %>" id="p-<%= p.id %>" data-id="<%= p.id %>" data-search="<%= (p.name + ' ' + p.brand).toLowerCase() %>">
    <%- include('../components/photo', { p: p, cls: 'prow__img', alt: '', sizes: '60px' }) %>
    <div class="prow__main">
      <p class="prow__name"><%= p.name %></p>
      <p class="prow__meta"><%= [p.brand, p.size].filter(Boolean).join(' · ') %> &middot; <strong><%= fmt.priceText(p) %></strong></p>
      <p class="prow__pills">
        <% if (p.isSample) { %><span class="sticker sticker--sample">Sample</span><% } %>
        <% if (p.descriptionDraft) { %><span class="sticker sticker--draft" title="The text is live on the site; open Edit and tick Approved when you are happy with it">Draft text</span><% } %>
        <% if (p.needsDetails) { %><span class="sticker sticker--needs" title="Add the price, size and concentration">Needs details</span><% } %>
        <span class="sticker <%= p.inStock ? 'sticker--new' : 'sticker--soldout' %>" data-stock-pill><%= p.inStock ? 'In stock' : 'Sold out' %></span>
        <span class="sticker sticker--bestseller" data-feature-pill<%= p.badges.includes('featured') ? '' : ' hidden' %>>Featured</span>
      </p>
    </div>
    <div class="prow__actions">
      <form method="post" action="/admin/products/<%= p.id %>/stock" data-async="stock">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--paper btn--sm" type="submit"><span data-label><%= p.inStock ? 'Mark sold out' : 'Mark in stock' %></span><span class="btn__spinner" aria-hidden="true"></span></button>
      </form>
      <form method="post" action="/admin/products/<%= p.id %>/feature" data-async="feature">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--paper btn--sm" type="submit"><%- icon('star') %><span data-label><%= p.badges.includes('featured') ? 'Unfeature' : 'Feature' %></span><span class="btn__spinner" aria-hidden="true"></span></button>
      </form>
      <%- include('../components/button', { href: '/admin/products/' + p.id + '/edit', ico: 'edit', label: 'Edit', variant: 'paper', size: 'sm' }) %>
      <form method="post" action="/admin/products/<%= p.id %>/delete" data-confirm="Delete &ldquo;<%= p.name %>&rdquo;? This also removes its photo and cannot be undone.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--paper btn--sm btn--danger-text" type="submit"><%- icon('trash') %><span>Delete</span></button>
      </form>
      <span class="prow__move">
        <form method="post" action="/admin/products/<%= p.id %>/move">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="dir" value="up">
          <button class="icon-btn" type="submit" aria-label="Move <%= p.name %> up" <%= idx === 0 ? 'disabled' : '' %>><%- icon('up') %></button>
        </form>
        <form method="post" action="/admin/products/<%= p.id %>/move">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="dir" value="down">
          <button class="icon-btn" type="submit" aria-label="Move <%= p.name %> down" <%= idx === products.length - 1 ? 'disabled' : '' %>><%- icon('down') %></button>
        </form>
      </span>
    </div>
  </li>
  <% }) %>
</ul>
<div class="empty" data-admin-empty hidden><p class="empty__title">No match.</p><p>No perfumes match your search.</p></div>
<p class="muted hint">Order here is the order shown on the website under &ldquo;Featured&rdquo; sorting.</p>
<% } %>
<%- include('_foot') %>
