<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)"><meta name="theme-color" content="#131312" media="(prefers-color-scheme: dark)">
  <title><%= seo.title %> | <%= site.brand.name %> Admin</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/urbanist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= asset('admin.css') %>">
</head>
<body class="admin" data-csrf="<%= csrfToken %>"<% if (query.saved) { %> data-toast="Saved."<% } else if (query.deleted) { %> data-toast="Deleted."<% } else if (query.changed) { %> data-toast="Password changed."<% } %>>
  <a class="skip-link" href="#main">Skip to content</a>
  <%- include('../components/icons') %>
  <% if (locals.showNav !== false) { %>
  <header class="admin-bar tone--inv">
    <div class="admin-bar__inner">
      <a class="admin-bar__brand" href="/admin"><span>Yannick <em>Scents</em> <small>Admin</small></span></a>
      <nav class="admin-nav" aria-label="Admin">
        <a href="/admin" <%- active === 'products' ? 'aria-current="page"' : '' %>>Perfumes</a>
        <a href="/admin/reviews" <%- active === 'reviews' ? 'aria-current="page"' : '' %>>Reviews</a>
        <a href="/admin/password" <%- active === 'password' ? 'aria-current="page"' : '' %>>Password</a>
        <a href="/" target="_blank" rel="noopener">View site</a>
      </nav>
      <form method="post" action="/admin/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--paper btn--sm" type="submit"><span>Log out</span></button>
      </form>
    </div>
  </header>
  <% } %>
  <main class="admin-main" id="main">
