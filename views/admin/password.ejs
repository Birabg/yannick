<%- include('_head', { seo: { title: 'Change password' } }) %>
<div class="page-head"><h1>Change password</h1></div>

<% if (done) { %><p class="alert alert--ok" role="status">Password changed. Use the new one next time you log in.</p><% } %>
<% if (errors.length) { %>
<div class="alert alert--error" role="alert">
  <ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul>
</div>
<% } %>

<form class="form form--narrow" method="post" action="/admin/password" novalidate data-validate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label class="field"><span class="field__label">Current password</span><input type="password" name="current" required autocomplete="current-password"><span class="field__error" hidden></span></label>
  <label class="field"><span class="field__label">New password (8+ characters)</span><input type="password" name="next" required minlength="8" autocomplete="new-password"><span class="field__error" hidden></span></label>
  <label class="field"><span class="field__label">Confirm new password</span><input type="password" name="confirm" required minlength="8" autocomplete="new-password" data-match="next"><span class="field__error" hidden></span></label>
  <button class="btn btn--lg" type="submit"><span>Change password</span><span class="btn__spinner" aria-hidden="true"></span></button>
</form>
<%- include('_foot') %>
