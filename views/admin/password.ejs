<%- include('_head', { seo: { title: 'Change password' } }) %>
<div class="page-head"><h1>Change password</h1></div>

<% if (done) { %><p class="alert alert--ok" role="status">Password changed. Use the new one next time you log in.</p><% } %>
<% if (errors.length) { %>
<div class="alert alert--error" role="alert">
  <ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul>
</div>
<% } %>

<form class="form" method="post" action="/admin/password">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label class="field"><span>Current password</span><input type="password" name="current" required autocomplete="current-password"></label>
  <label class="field"><span>New password (8+ characters)</span><input type="password" name="next" required minlength="8" autocomplete="new-password"></label>
  <label class="field"><span>Confirm new password</span><input type="password" name="confirm" required minlength="8" autocomplete="new-password"></label>
  <button class="btn btn-primary" type="submit">Change password</button>
</form>
<%- include('_foot') %>
