<%- include('_head', { seo: { title: 'Log in' }, showNav: false, active: '' }) %>
<div class="login tone--stone">
  <div class="login__card">
    <h1 class="login__title">Admin</h1>
    <p class="muted">Yannick Scents</p>
    <% if (error) { %><p class="alert alert--error" role="alert"><%= error %></p><% } %>
    <form method="post" action="/admin/login" class="form" data-validate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="next" value="<%= next %>">
      <label class="field">
        <span class="field__label">Password</span>
        <input type="password" name="password" required autocomplete="current-password" autofocus>
        <span class="field__error" hidden></span>
      </label>
      <button class="btn btn--lg btn--block" type="submit"><span>Log in</span><span class="btn__spinner" aria-hidden="true"></span></button>
    </form>
    <a class="login__back" href="/">&larr; Back to the website</a>
  </div>
</div>
<%- include('_foot') %>
