<%
  const hasReviews = reviews.length > 0;
  const quizData = {
    whatsapp: site.contact.whatsapp,
    steps: [
      { id: 'who', question: 'Who is it for?', options: site.quiz.who },
      { id: 'vibe', question: 'What kind of scent?', options: site.quiz.vibe },
      { id: 'budget', question: 'What would you like to spend?', options: site.quiz.budget },
    ],
  };
  const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];
  let step = 0;
  const num = function () { return ROMAN[step++]; };
%>
<%- include('partials/head', { preloadHero: true }) %>
<main id="main">

  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media">
      <img class="hero__img" src="/img/hero.svg" width="1200" height="1000" alt="Three perfume bottles on a warm stone shelf" fetchpriority="high">
    </div>
    <div class="hero__copy">
      <div class="hero__inner">
        <p class="hero__eyebrow" <%- i('hero.eyebrow') %>><%= t('hero.eyebrow') %></p>
        <h1 class="hero__title" id="hero-title" <%- i('hero.title') %>><%- rich(t('hero.title')) %></h1>
        <p class="hero__text" <%- i('hero.sub') %>><%= t('hero.sub') %></p>
        <div class="hero__cta">
          <%- include('components/button', { href: fmt.genericLink(), external: true, ico: 'whatsapp', label: t('cta.whatsapp'), i18n: 'cta.whatsapp', size: 'lg' }) %>
          <%- include('components/button', { href: '#find', label: t('cta.find'), i18n: 'cta.find', variant: 'outline', size: 'lg' }) %>
        </div>
        <ul class="hero__facts">
          <li <%- i('hero.f1') %>><%= t('hero.f1') %></li>
          <li <%- i('hero.f2') %>><%= t('hero.f2') %></li>
          <li <%- i('hero.f3') %>><%= t('hero.f3') %></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- I. Story -->
  <section class="section tone--ivory" id="story" aria-labelledby="story-title">
    <div class="container story">
      <div class="story__photo reveal">
        <div class="story__frame">
          <img src="<%= site.founderPhoto %>" width="600" height="750" loading="lazy" alt="Yannick, founder of <%= site.brand.name %>">
        </div>
        <p class="story__caption">Yannick &middot; <%= site.location.city %></p>
      </div>
      <div class="story__copy reveal reveal--2">
        <p class="label"><span class="label__num"><%= num() %></span><span <%- i('story.label') %>><%= t('story.label') %></span></p>
        <h2 class="story__statement" id="story-title"><%- rich(site.story.statement) %></h2>
        <% site.story.paragraphs.forEach(function (para) { %><p><%= para %></p><% }) %>
        <ul class="facts">
          <% site.facts.forEach(function (f) { %>
          <li class="fact"><span class="fact__num"><%= f.num %></span><span class="fact__text"><strong><%= f.title %></strong><%= f.text %></span></li>
          <% }) %>
        </ul>
      </div>
    </div>
  </section>

  <!-- II. Collection -->
  <section class="section tone--ivory" id="collection" aria-labelledby="collection-title">
    <div class="container">
      <%- include('components/section-head', { key: 'collection', titleId: 'collection-title', num: num(), lead: true }) %>

      <div class="collection__top">
        <p class="collection__count" data-count-label aria-live="polite"><%= products.length %> <%= products.length === 1 ? 'perfume' : 'perfumes' %></p>
        <div class="tools">
          <div class="search">
            <%- icon('search') %>
            <input id="search" type="search" placeholder="<%= t('search.placeholder') %>" data-i18n-placeholder="search.placeholder" aria-label="Search perfumes" autocomplete="off">
          </div>
          <label class="sort"><span <%- i('sort.label') %>><%= t('sort.label') %></span>
            <select id="sort">
              <option value="featured" <%- i('sort.featured') %>><%= t('sort.featured') %></option>
              <option value="low" <%- i('sort.low') %>><%= t('sort.low') %></option>
              <option value="high" <%- i('sort.high') %>><%= t('sort.high') %></option>
            </select>
          </label>
        </div>
      </div>

      <div class="filterbar" role="group" aria-label="Filter perfumes">
        <div class="tabs">
          <%- include('components/tab', { filter: 'all', label: t('filter.all'), pressed: true, i18n: 'filter.all' }) %>
          <% site.collections.forEach(function (c) { %><%- include('components/tab', { filter: c.key, label: c.label, pressed: false }) %><% }) %>
        </div>
      </div>

      <div class="grid-wrap">
        <ul class="grid" id="grid">
          <% products.forEach(function (p, n) { %><%- include('components/product-card', { p: p, order: n }) %><% }) %>
        </ul>
        <div class="empty" data-empty hidden>
          <p class="empty__title">Nothing matches that.</p>
          <p>Try fewer filters or a different word. Or ask us, we may have it.</p>
          <div class="error-page__actions">
            <button type="button" class="btn btn--ink" data-reset><span>Clear filters</span></button>
            <%- include('components/button', { href: fmt.genericLink(), external: true, ico: 'whatsapp', label: 'Ask on WhatsApp', variant: 'outline' }) %>
          </div>
        </div>
        <% if (!products.length) { %>
        <div class="empty">
          <p class="empty__title">New bottles are on the way.</p>
          <p>The shelf is being restocked. Message us and we will tell you what we have.</p>
          <%- include('components/button', { href: fmt.genericLink(), external: true, ico: 'whatsapp', label: t('cta.whatsapp'), i18n: 'cta.whatsapp' }) %>
        </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- III. Olfactory journey -->
  <section class="section tone--ink" id="notes" aria-labelledby="notes-title">
    <div class="container journey">
      <%- include('components/section-head', { key: 'journey', titleId: 'notes-title', num: num(), lead: true }) %>
      <ol class="journey__tiers">
        <% site.journey.forEach(function (s, n) { %>
        <li class="tier reveal reveal--<%= n + 1 %>">
          <span class="tier__num" aria-hidden="true"><%= ROMAN[n] %></span>
          <h3 class="tier__title"><%= s.title %></h3>
          <p class="tier__time"><%= s.time %></p>
          <p class="tier__text"><%= s.text %></p>
          <ul class="tier__notes"><% s.notes.forEach(function (note) { %><li><%= note %></li><% }) %></ul>
        </li>
        <% }) %>
      </ol>
    </div>
  </section>

  <!-- IV. Houses -->
  <section class="section tone--stone" id="houses" aria-labelledby="houses-title">
    <div class="container">
      <%- include('components/section-head', { key: 'houses', titleId: 'houses-title', num: num() }) %>
      <div class="houses reveal">
        <% site.houses.forEach(function (h) { %><p class="house"><%= h %></p><% }) %>
      </div>
      <p class="houses-note" <%- i('houses.note') %>><%= t('houses.note') %></p>
    </div>
  </section>

  <!-- V. Find your scent -->
  <section class="section tone--ivory" id="find" aria-labelledby="find-title">
    <div class="container quiz" id="quiz">
      <div class="quiz__aside reveal">
        <p class="label"><span class="label__num"><%= num() %></span><span <%- i('quiz.label') %>><%= t('quiz.label') %></span></p>
        <h2 class="sec-title" id="find-title" <%- i('quiz.title') %>><%- rich(t('quiz.title')) %></h2>
        <p class="sec-lead" <%- i('quiz.lead') %>><%= t('quiz.lead') %></p>
      </div>
      <div class="quiz__panel reveal reveal--2" data-quiz-panel aria-live="polite">
        <noscript><p>Turn on JavaScript for the guide, or <a class="ulink" href="<%= fmt.genericLink() %>">message us on WhatsApp</a>.</p></noscript>
      </div>
      <script type="application/json" id="quiz-data"><%- JSON.stringify(quizData).replace(/</g, '\\u003c') %></script>
    </div>
  </section>

  <% if (hasReviews) { %>
  <!-- Reviews -->
  <section class="section tone--stone" id="reviews" aria-labelledby="reviews-title">
    <div class="container">
      <%- include('components/section-head', { key: 'reviews', titleId: 'reviews-title', num: num() }) %>
      <div class="reviews">
        <% reviews.forEach(function (r) { %>
        <figure class="review reveal">
          <p class="review__stars" role="img" aria-label="<%= r.rating %> out of 5 stars">
            <% for (let s = 1; s <= 5; s++) { %><%- icon('star', s <= r.rating ? 'is-on' : '') %><% } %>
          </p>
          <% if (r.text) { %><blockquote class="review__text"><%= r.text %></blockquote><% } %>
          <% if (r.image) { %><img class="review__shot" src="/uploads/reviews/<%= r.image %>" width="<%= r.image_w || 600 %>" height="<%= r.image_h || 800 %>" loading="lazy" alt="Message from <%= r.name %>"><% } %>
          <figcaption class="review__name"><%= r.name %></figcaption>
        </figure>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- FAQ -->
  <section class="section tone--<%= hasReviews ? 'ivory' : 'stone' %>" id="faq" aria-labelledby="faq-title">
    <div class="container faq-layout">
      <%- include('components/section-head', { key: 'faq', titleId: 'faq-title', num: num() }) %>
      <div class="faq reveal reveal--2">
        <% site.faq.forEach(function (item) { %>
        <details>
          <summary><span><%= item.q %></span><span class="faq__icon" aria-hidden="true"></span></summary>
          <p><%= item.a %></p>
        </details>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Order -->
  <section class="section tone--<%= hasReviews ? 'stone' : 'ivory' %>" id="order" aria-labelledby="order-title">
    <div class="container">
      <%- include('components/section-head', { key: 'order', titleId: 'order-title', num: num(), lead: true }) %>
      <div class="cblocks reveal">
        <a class="cblock" href="<%= fmt.genericLink() %>" target="_blank" rel="noopener">
          <span class="cblock__kicker">WhatsApp</span>
          <span class="cblock__title">Message us</span>
          <span class="cblock__sub">The quickest way. We reply personally.</span>
        </a>
        <a class="cblock" href="tel:<%= site.contact.phone %>">
          <span class="cblock__kicker">Telephone</span>
          <span class="cblock__title"><%= site.contact.phoneDisplay %></span>
          <span class="cblock__sub">Call during opening hours.</span>
        </a>
        <a class="cblock" href="<%= site.contact.tiktok %>" target="_blank" rel="noopener">
          <span class="cblock__kicker">TikTok</span>
          <span class="cblock__title"><%= site.contact.tiktokHandle %></span>
          <span class="cblock__sub">See the bottles in motion.</span>
        </a>
      </div>

      <h3 class="label" <%- i('order.steps') %>><%= t('order.steps') %></h3>
      <ol class="steps">
        <% site.howToOrder.forEach(function (s, n) { %>
        <li class="step reveal reveal--<%= n + 1 %>">
          <span class="step__num" aria-hidden="true"><%= ROMAN[n] %></span>
          <div><h4 class="step__title"><%= s.title %></h4><p><%= s.text %></p></div>
        </li>
        <% }) %>
      </ol>

      <div class="infos">
        <div class="info">
          <h3 class="info__title">Hours</h3>
          <ul>
            <% site.hours.forEach(function (h) { %><li><span><%= h.days %></span><strong><%= h.time %></strong></li><% }) %>
          </ul>
          <p class="info__note"><%= site.hoursNote %></p>
        </div>
        <div class="info">
          <h3 class="info__title">Delivery</h3>
          <p><%= site.location.text %></p>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('components/sheet') %>
<div class="toasts" id="toasts" aria-live="polite"></div>
<%- include('partials/foot') %>
