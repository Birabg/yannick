<%
  const hasReviews = reviews.length > 0;
  const quizData = {
    whatsapp: site.contact.whatsapp,
    steps: [
      { id: 'who', question: 'Who is it for?', options: site.quiz.who },
      { id: 'vibe', question: 'What kind of scent?', options: site.quiz.vibe },
      { id: 'budget', question: 'What would you like to spend?', options: site.quiz.budget },
    ],
  };
  let step = 1; // the hero's "01" card is the first number
  const num = function () { return String(++step).padStart(2, '0'); };
%>
<%- include('partials/head', { preloadImage: heroProducts[0] || null, preloadImage2: heroProducts[1] || null }) %>
<main id="main">

  <!-- Hero -->
  <%
    const heroCards = heroProducts.slice(0, 5);
    const founderLine = site.heroLine.replace(/\*/g, '');
  %>
  <section class="hero" id="top" aria-labelledby="hero-title" data-hero>
    <div class="hero__main">
      <%- include('components/hero-background') %>
      <div class="container hero__top">
        <div class="hero__copy">
          <%- include('components/hero-headline') %>
          <%- include('components/hero-cta') %>
        </div>
        <%- include('components/story-card') %>
      </div>
      <% if (heroCards.length) { %><%- include('components/hero-cards', { items: heroCards, more: moreCount }) %><% } %>
    </div>

    <div class="container hero__foot">
      <figure class="quote">
        <span class="quote__mark" aria-hidden="true">&ldquo;</span>
        <blockquote class="quote__text"><%= quote ? quote.text : founderLine %></blockquote>
        <figcaption class="quote__cap">
          <span class="quote__sign"><%= quote ? quote.name : 'Yannick' %></span>
          <% if (!quote) { %><span class="quote__role" <%- i('quote.founder') %>><%= t('quote.founder') %></span><% } %>
        </figcaption>
      </figure>
      <a class="teaser" href="#find">
        <span class="teaser__num" aria-hidden="true">01</span>
        <span class="teaser__body">
          <span class="teaser__label" <%- i('quiz.label') %>><%= t('quiz.label') %></span>
          <strong class="teaser__line" <%- i('hero.teaser') %>><%= t('hero.teaser') %></strong>
        </span>
        <span class="teaser__go" aria-hidden="true"><%- icon('arrow') %></span>
      </a>
    </div>
  </section>

  <!-- Most Loved Right Now: Best Sellers, topped up (src/lib/loved.js). The layout follows how many there are; none, no section. -->
  <% if (loved.length) { %>
  <% const lovedMode = loved.length >= 4 ? 'grid' : 'n' + loved.length; %>
  <section class="section tone--bg loved loved--<%= lovedMode %>" id="loved" aria-labelledby="loved-title" data-rv>
    <div class="container">
      <header class="loved__head" data-rv-item>
        <div class="loved__titles">
          <p class="label"><span class="label__num"><%= num() %></span><span <%- i('loved.label') %>><%= t('loved.label') %></span></p>
          <h2 class="sec-title" id="loved-title" <%- i('loved.title') %>><%- rich(t('loved.title')) %></h2>
          <p class="sec-lead" <%- i('loved.lead') %>><%= t('loved.lead') %></p>
        </div>
        <a class="loved__all" href="#collection"><span <%- i('loved.all') %>><%= t('loved.all') %></span><%- icon('arrow') %></a>
      </header>
    </div>
    <ul class="loved__list" aria-labelledby="loved-title">
      <% loved.forEach(function (p, n) { %><%- include('components/loved-card', { p: p, one: loved.length === 1, eager: false }) %><% }) %>
      <% if (loved.length > 1 && loved.length < 4) { %>
      <li class="lc lc--more" data-rv-item>
        <div class="lc__tile">
          <a class="lc__more" href="#collection">
            <span class="lc__more-count" aria-hidden="true"><%= products.length %></span>
            <span class="lc__more-label" <%- i('loved.countLabel') %>><%= t('loved.countLabel') %></span>
            <strong class="lc__more-see" <%- i('loved.see') %>><%= t('loved.see') %></strong>
          </a>
          <span class="lc__go" aria-hidden="true"><%- icon('arrow-ur') %></span>
        </div>
      </li>
      <% } %>
    </ul>
  </section>
  <% } %>

  <!-- II. Collection -->
  <section class="section tone--bg collection" id="collection" aria-labelledby="collection-title">
    <div class="container">
      <header class="coll__head">
        <%- include('components/section-head', { key: 'collection', titleId: 'collection-title', num: num(), lead: true }) %>
        <p class="coll__count" aria-live="polite">
          <span data-count-n><%= products.length %></span>
          <span data-count-one <%- i('collection.one') %><%- products.length === 1 ? '' : ' hidden' %>><%= t('collection.one') %></span><span data-count-many <%- i('collection.many') %><%- products.length === 1 ? ' hidden' : '' %>><%= t('collection.many') %></span>
          <span class="coll__active" data-count-active hidden></span>
        </p>
      </header>

      <div class="coll__tools">
        <div class="search">
          <%- icon('search') %>
          <label class="sr-only" for="search" <%- i('search.label') %>><%= t('search.label') %></label>
          <input id="search" type="search" placeholder="<%= t('search.placeholder') %>" data-i18n-placeholder="search.placeholder" autocomplete="off">
          <button type="button" class="search__clear" data-search-clear hidden aria-label="<%= t('search.clear') %>" data-i18n-aria="search.clear"><span aria-hidden="true">&times;</span></button>
        </div>
        <label class="sort"><span <%- i('sort.label') %>><%= t('sort.label') %></span>
          <select id="sort">
            <option value="featured" <%- i('sort.featured') %>><%= t('sort.featured') %></option>
            <option value="low" <%- i('sort.low') %>><%= t('sort.low') %></option>
            <option value="high" <%- i('sort.high') %>><%= t('sort.high') %></option>
          </select>
        </label>
      </div>

      <div class="filterbar" role="group" aria-label="Filter perfumes" data-filter-keys="<%= filterKeys.join(' ') %>">
        <div class="tabs" data-tabs>
          <%- include('components/tab', { filter: 'all', label: t('filter.all'), count: products.length, pressed: true, i18n: 'filter.all' }) %>
          <% tabs.forEach(function (c) { %><%- include('components/tab', { filter: c.key, label: c.label, count: c.count, pressed: false }) %><% }) %>
        </div>
      </div>

      <p class="brandbar" data-brandbar hidden>
        <span <%- i('houses.showing') %>><%= t('houses.showing') %></span>
        <strong data-brand-name></strong>
        <button type="button" class="brandbar__clear" data-brand-clear><span <%- i('houses.clear') %>><%= t('houses.clear') %></span><span aria-hidden="true"> ×</span></button>
      </p>

      <div class="grid-wrap" data-rv>
        <ul class="grid" id="grid">
          <% products.forEach(function (p, n) { %><%- include('components/product-card', { p: p, order: n, rv: true }) %><% }) %>
        </ul>
        <div class="empty" data-empty hidden>
          <p class="empty__title" data-empty-title data-text-filter="Nothing here yet. Ask Yannick on WhatsApp" data-text-search="Nothing matches that.">Nothing matches that.</p>
          <p data-empty-text>Try fewer filters or a different word. Or ask us, we may have it.</p>
          <div class="error-page__actions">
            <button type="button" class="btn btn--ink" data-reset><span <%- i('filter.clear') %>><%= t('filter.clear') %></span></button>
            <%- include('components/button', { href: fmt.genericLink(), external: true, ico: 'whatsapp', label: 'Ask on WhatsApp', variant: 'outline' }) %>
          </div>
        </div>
        <% if (!products.length) { %>
        <div class="empty">
          <p class="empty__title">New bottles are on the way.</p>
          <p>The shelf is being restocked. Message us and we will tell you what we have.</p>
          <%- include('components/button', { href: fmt.genericLink(), external: true, ico: 'whatsapp', label: t('cta.whatsapp'), i18n: 'cta.whatsapp' }) %>
        </div>
        <% } %>
      </div>
      <% if (products.length > 12) { %>
      <div class="coll__more" data-more-wrap hidden>
        <button type="button" class="btn btn--outline btn--lg" data-more><span <%- i('collection.more') %>><%= t('collection.more') %></span></button>
      </div>
      <% } %>
    </div>
  </section>

  <!-- Scent families: expanding panels -->
  <% if (families.length) { %><%- include('components/scent-accordion', { families: families, num: num() }) %><% } %>

  <!-- Notes: how a scent unfolds -->
  <section class="section tone--bg" id="notes" aria-labelledby="notes-title">
    <div class="container">
      <%- include('components/section-head', { key: 'journey', titleId: 'notes-title', num: num(), lead: true }) %>
      <ol class="nc-grid">
        <% site.journey.forEach(function (s, n) { %>
        <li class="nc fam--<%= ['fresh', 'oriental', 'woody'][n] %> reveal reveal--<%= n + 1 %>">
          <div class="nc__top">
            <p class="nc__num" aria-hidden="true"><%= String(n + 1).padStart(2, '0') %></p>
            <h3 class="nc__title"><%= s.title %></h3>
            <p class="nc__time"><%= s.time %></p>
          </div>
          <p class="nc__text"><%= s.text %></p>
          <ul class="nc__notes"><% s.notes.forEach(function (note) { %><li><%= note %></li><% }) %></ul>
        </li>
        <% }) %>
      </ol>
    </div>
  </section>

  <!-- By mood -->
  <% const moodList = moods.filter(function (m) { return m.picks.length; }); %>
  <% if (moodList.length >= 2) { %>
  <section class="section tone--surface" id="mood" data-mood aria-labelledby="mood-title">
    <div class="container mood">
      <header class="sec-head reveal">
        <p class="label"><span class="label__num"><%= String(++step).padStart(2, '0') %></span><span>By mood</span></p>
        <h2 class="sec-title" id="mood-title">When will you wear it?</h2>
        <p class="sec-lead">Pick a moment. We will show three bottles that suit it.</p>
      </header>
      <div class="mood__main">
        <div class="mood__picker" role="radiogroup" aria-label="Scent by mood">
          <% moodList.forEach(function (m, n) { %>
          <button class="mood__btn mood__btn--<%= m.key %>" type="button" role="radio" aria-checked="<%= n === 0 %>" data-mood-btn="<%= m.key %>"><%= m.label %></button>
          <% }) %>
        </div>
        <% moodList.forEach(function (m, n) { %>
        <div class="mood__panel" data-mood-panel="<%= m.key %>" <%= n === 0 ? '' : 'hidden' %>>
          <p class="mood__line"><%= m.line %></p>
          <ul class="mood__list">
            <% m.picks.forEach(function (p) { %>
            <li class="pick">
              <span class="pick__img fam--<%= fmt.cardColor(p) %>"><%- include('components/photo', { p: p, cls: 'pick__photo', alt: '', sizes: '96px' }) %></span>
              <div class="pick__body">
                <p class="pick__brand"><%= p.brand %></p>
                <h3 class="pick__name"><a href="/perfume/<%= p.slug %>" data-open-product><%= p.name %></a></h3>
                <p class="pick__meta"><%= [p.size, p.concentration, fmt.price(p.price)].filter(Boolean).join(' · ') %></p>
              </div>
              <a class="btn btn--sm pick__order" href="<%= fmt.orderLink(p) %>" target="_blank" rel="noopener"><span>Order</span><span class="sr-only"> <%= fmt.productLabel(p) %> on WhatsApp</span></a>
            </li>
            <% }) %>
          </ul>
        </div>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Our Story -->
  <section class="section tone--bg" id="story" aria-labelledby="story-title">
    <div class="container story">
      <figure class="story__photo zoom">
        <div class="story__frame-wrap">
          <div class="story__frame" data-story-frame>
            <% if (story.photo) {
              const ph = story.photo;
              const set = function (ext) { return ph.widths.map(function (w) { return ph.url + '/' + ph.base + '-' + w + '.' + ext + ' ' + w + 'w'; }).join(', '); };
              const top = ph.widths[ph.widths.length - 1];
            %>
            <picture>
              <source type="image/avif" srcset="<%= set('avif') %>" sizes="(min-width: 1024px) 46vw, (min-width: 700px) 38vw, 100vw">
              <source type="image/webp" srcset="<%= set('webp') %>" sizes="(min-width: 1024px) 46vw, (min-width: 700px) 38vw, 100vw">
              <img class="story__img fx-<%= Math.round(story.focus.x / 10) * 10 %> fy-<%= Math.round(story.focus.y / 10) * 10 %>" src="<%= ph.url %>/<%= ph.base %>-<%= top %>.webp" width="<%= ph.width %>" height="<%= ph.height %>" alt="<%= story.alt %>" loading="lazy" decoding="async" data-story-img>
            </picture>
            <% } %>
            <span class="story__placeholder" aria-hidden="true">Y</span>
          </div>
        </div>
        <figcaption class="story__caption"<% if (story.am.caption) { %> data-am="<%= story.am.caption %>"<% } %>><%= story.caption %></figcaption>
      </figure>

      <div class="story__copy">
        <p class="story__eyebrow rise d1" data-am="<%= story.am.eyebrow %>"><%= story.eyebrow %></p>
        <h2 class="story__heading rise d2" id="story-title" data-am="<%= story.am.heading %>"><%= story.heading %></h2>
        <% story.paragraphs.forEach(function (para, n) { %>
        <p class="story__text rise d<%= Math.min(n + 3, 5) %>" data-am="<%= story.am.paragraphs[n] %>"><%= para %></p>
        <% }) %>
        <ul class="story__stats">
          <% story.stats.forEach(function (s, n) { %>
          <li class="story__stat rise d<%= Math.min(n + 3, 5) %>">
            <span class="story__value" data-am="<%= s.valueAm %>"><%= s.value %></span>
            <span class="story__label" data-am="<%= s.labelAm %>"><%= s.label %></span>
          </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </section>

  <!-- IV. Houses -->
  <section class="section tone--surface" id="houses" aria-labelledby="houses-title">
    <div class="container"><%- include('components/section-head', { key: 'houses', titleId: 'houses-title', num: num(), lead: true }) %></div>
    <%- include('components/houses-marquee', { houses: houses, houseCss: houseCss }) %>
    <div class="container"><p class="houses-trust" <%- i('houses.trust') %>><%= t('houses.trust') %></p></div>
  </section>

  <!-- V. Find your scent -->
  <section class="section tone--bg" id="find" aria-labelledby="find-title">
    <div class="container quiz" id="quiz" data-rv>
      <div class="quiz__aside" data-rv-item>
        <p class="label"><span class="label__num"><%= num() %></span><span <%- i('quiz.label') %>><%= t('quiz.label') %></span></p>
        <h2 class="sec-title" id="find-title" <%- i('quiz.title') %>><%- rich(t('quiz.title')) %></h2>
        <p class="sec-lead" <%- i('quiz.lead') %>><%= t('quiz.lead') %></p>
      </div>
      <div class="quiz__panel" data-quiz-panel data-rv-item>
        <noscript><p class="quiz__nojs"><%= t('quiz.noJs') %> <a class="ulink" href="<%= fmt.genericLink() %>">WhatsApp</a></p></noscript>
      </div>
      <script type="application/json" id="quiz-data"><%- JSON.stringify(Object.assign({}, quizData, { strings: quizStrings })).replace(/</g, '\\u003c') %></script>
    </div>
  </section>

  <% if (hasReviews) { %>
  <!-- Reviews -->
  <section class="section tone--surface" id="reviews" aria-labelledby="reviews-title">
    <div class="container">
      <%- include('components/section-head', { key: 'reviews', titleId: 'reviews-title', num: num() }) %>
      <div class="reviews">
        <% reviews.forEach(function (r) { %>
        <figure class="review reveal">
          <p class="review__stars" role="img" aria-label="<%= r.rating %> out of 5 stars">
            <% for (let s = 1; s <= 5; s++) { %><%- icon('star', s <= r.rating ? 'is-on' : '') %><% } %>
          </p>
          <% if (r.text) { %><blockquote class="review__text"><%= r.text %></blockquote><% } %>
          <% if (r.image) { %><img class="review__shot" src="/uploads/reviews/<%= r.image %>" width="<%= r.image_w || 600 %>" height="<%= r.image_h || 800 %>" loading="lazy" alt="Message from <%= r.name %>"><% } %>
          <figcaption class="review__name"><%= r.name %></figcaption>
        </figure>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- FAQ -->
  <section class="section tone--<%= hasReviews ? 'ivory' : 'stone' %>" id="faq" aria-labelledby="faq-title">
    <div class="container faq-layout" data-rv>
      <div data-rv-item><%- include('components/section-head', { key: 'faq', titleId: 'faq-title', num: num() }) %></div>
      <%- include('components/faq', { items: site.faq }) %>
    </div>
  </section>

  <!-- Order -->
  <section class="section tone--bg" id="order" aria-labelledby="order-title">
    <div class="container">
      <div class="order">
        <div class="order__panel notch notch--ink">
          <p class="label"><span class="label__num"><%= num() %></span><span <%- i('order.label') %>><%= t('order.label') %></span></p>
          <h2 class="sec-title" id="order-title" <%- i('order.title') %>><%= t('order.title').replace(/\*/g, '') %></h2>
          <p class="sec-lead" <%- i('order.lead') %>><%= t('order.lead') %></p>
          <div class="order__cta">
            <%- include('components/button', { href: fmt.genericLink(), external: true, ico: 'whatsapp', label: t('cta.whatsapp'), i18n: 'cta.whatsapp', size: 'lg' }) %>
            <%- include('components/button', { href: 'tel:' + site.contact.phone, ico: 'phone', label: site.contact.phoneDisplay, variant: 'outline', size: 'lg' }) %>
          </div>
        </div>
        <div class="order__glass notch" data-shader data-src="<%= distAsset('hero/island.js') %>" data-lazy aria-hidden="true">
          <span class="hero-shader__stage" data-stage></span>
          <% if (heroProducts[0]) { %><% const ob = heroProducts[0]; %><% if (ob.cutW > 0) { %><img class="order__bottle is-cutout" src="/uploads/products/<%= ob.image %>-cut.webp" width="<%= ob.cutW %>" height="<%= ob.cutH %>" alt="" loading="lazy" decoding="async" data-photo><% } else { %><%- include('components/photo', { p: ob, cls: 'order__bottle', alt: '', variant: 'lg', sizes: '(min-width: 900px) 40vw, 90vw' }) %><% } %><% } %>
        </div>
      </div>

      <%- include('components/contact-blocks') %>

      <h3 class="label order__steps-label" <%- i('order.steps') %>><%= t('order.steps') %></h3>
      <ol class="steps" data-rv data-steps>
        <% site.howToOrder.forEach(function (s, n) { %>
        <li class="step" data-rv-item>
          <span class="step__dot" aria-hidden="true"></span>
          <span class="step__num" aria-hidden="true"><%= String(n + 1).padStart(2, '0') %></span>
          <div><h4 class="step__title"><%= s.title %></h4><p><%= s.text %></p></div>
        </li>
        <% }) %>
      </ol>

      <%- include('components/hours-card', { hours: hours }) %>
    </div>
  </section>
</main>

<%- include('components/sheet') %>
<div class="toasts" id="toasts" aria-live="polite"></div>
<%- include('partials/foot') %>
