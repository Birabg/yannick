# Copy to .env and fill in. Never commit .env.
PORT=3000
# Use "production" on the live server
NODE_ENV=development
SITE_URL=http://localhost:3000

# Long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Initial admin password. It is hashed and stored in the database on first run;
# afterwards change it from Admin > Password (this value is then ignored).
ADMIN_PASSWORD=

# Contact details (international format)
PHONE=+251942996655
WHATSAPP_NUMBER=251942996655

# Database: Turso (https://turso.tech). Required in production, e.g. on Vercel.
# Leave both empty in development to use a local file at data/yannick.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: local dev database folder, and where uploaded photos live
# DATA_DIR=./data
# UPLOADS_DIR=./uploads
